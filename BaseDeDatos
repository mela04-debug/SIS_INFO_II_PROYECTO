-- ========================================================
-- HISTORIA DE USUARIO 2: SESIONES DE PAIR PROGRAMMING
-- ========================================================

CREATE TABLE sesion_pair_programming (
    id INT IDENTITY(1,1) PRIMARY KEY,
    id_programador1 INT NOT NULL,
    id_programador2 INT NOT NULL,
    fecha DATE NOT NULL,
    hora_inicio TIME NOT NULL,
    hora_fin TIME NOT NULL,
    descripcion TEXT NOT NULL,
    id_tarea INT NOT NULL,
    fecha_creacion DATETIME DEFAULT GETDATE(),
    FOREIGN KEY (id_programador1) REFERENCES usuario(id),
    FOREIGN KEY (id_programador2) REFERENCES usuario(id),
    FOREIGN KEY (id_tarea) REFERENCES tarea_modulo(id)
);
