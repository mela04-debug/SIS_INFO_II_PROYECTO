-- ========================================================
-- TABLAS COMUNES Y CONFIGURACIÓN (Usuarios y Tareas)
-- ========================================================

CREATE TABLE usuario (
    id INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL,
    rol VARCHAR(30) NOT NULL CHECK (rol IN ('DESARROLLADOR', 'ADMINISTRADOR'))
);

CREATE TABLE tarea_modulo (
    id INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    tipo VARCHAR(20) NOT NULL CHECK (tipo IN ('TAREA', 'TARJETA', 'MODULO')),
    fecha DATE NOT NULL
);

