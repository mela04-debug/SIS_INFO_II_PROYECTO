-- ========================================================
-- HISTORIA DE USUARIO 1: VALIDACIÓN AUTOMÁTICA DE PRUEBAS
-- ========================================================

CREATE TABLE merge_request (
    id_merge VARCHAR(50) PRIMARY KEY,
    rama_origen VARCHAR(100) NOT NULL,
    rama_destino VARCHAR(100) NOT NULL,
    descripcion TEXT,
    fecha_solicitud DATE NOT NULL,
    estado VARCHAR(30) DEFAULT 'PENDIENTE' CHECK (estado IN ('PENDIENTE', 'EN_VALIDACION', 'EXITOSO', 'FALLIDO', 'RECHAZADO'))
);

CREATE TABLE historial_validacion (
    id_historial INT IDENTITY(1,1) PRIMARY KEY,
    id_merge VARCHAR(50) NOT NULL,
    fecha DATETIME NOT NULL,
    resultado_pruebas TEXT NOT NULL,
    id_desarrollador INT NOT NULL,
    estado_validacion VARCHAR(30) NOT NULL CHECK (estado_validacion IN ('EN_PROCESO', 'EXITOSO', 'FALLIDO', 'CANCELADO')),
    mensaje VARCHAR(255),
    FOREIGN KEY (id_merge) REFERENCES merge_request(id_merge),
    FOREIGN KEY (id_desarrollador) REFERENCES usuario(id)
);

